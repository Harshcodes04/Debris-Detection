# Signing key for access tokens. Required when ENVIRONMENT=production, and must
# be at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SIH_SECRET_KEY=
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=720

# The first admin, created once on first startup if the users table is empty.
# Without these a fresh database has no accounts and nobody can sign in.
BOOTSTRAP_ADMIN_EMAIL=admin@sih.local
BOOTSTRAP_ADMIN_PASSWORD=

LOG_LEVEL=INFO

DATA_DIR=../data
# Leave DATABASE_URL unset to use SQLite at <DATA_DIR>/debris.db, which is
# what a local checkout needs - no Postgres, no Docker. Uncomment only if
# you are running the Postgres from docker-compose.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/sih_ps57
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=local
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_EXTENSIONS=png,jpg,jpeg,tif,tiff,xtf,jsf,segy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
