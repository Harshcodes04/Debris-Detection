# Generate a secure key for production using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SIH_SECRET_KEY=dev-only-insecure-key-not-for-deployment-0123456789

# Set to "production" to enforce security checks
ENVIRONMENT=development

# Database configuration (defaults to postgres if omitted)
# POSTGRES_PASSWORD=your_secure_password_here

# First-time setup: creates the initial admin account
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=admin

# Set to true if deploying behind a reverse proxy (like Nginx)
TRUST_PROXY_HEADERS=false

# Token expiration time in minutes
ACCESS_TOKEN_MINUTES=720
