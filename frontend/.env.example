# Where the API lives. Leave empty for local development - Vite proxies /api to
# localhost:8000 and a relative path works.
#
# On Vercel this must be the full origin of the Render service, with no trailing
# slash and no /api suffix:
#   VITE_API_BASE_URL=https://sih-ps57-api.onrender.com
#
# Vite inlines this at build time, not at runtime, so changing it needs a rebuild.
VITE_API_BASE_URL=
